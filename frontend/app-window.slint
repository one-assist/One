
//This is the main window of the application.

import { VoiceOrb } from "voice-orb.slint";
import { ScrollView } from "std-widgets.slint";

export component MainWindow inherits Window {
    // A root Window has no parent for percentage sizing; maximized windows use
    // the current display dimensions, while the content below fills it at 100%.
    maximized: true;
    background: #03080d;
    in-out property <bool> assistant-listening;
    in-out property <bool> assistant-ready: false;
    in-out property <bool> assistant-speaking: false;
    in-out property <string> assistant-status: "Loading speech recognition...";
    in-out property <bool> panel-open: false;
    in-out property <string> panel-title: "Session";
    in-out property <string> panel-content: "";
    callback start_program();
    callback toggle-panel();

    //main gradient
    Rectangle{
        width: 100%;
        height: 100%;

        background: @linear-gradient(
            135deg,
            #261219 0%,
            #03080d 42%,
            #03080d 100%
        );
    }
    //glare on the left side
    Rectangle {
        x: -200px;
        y: parent.height - 500px;
        width: 700px;
        height: 700px;
        border-radius: 350px;

        background: @radial-gradient(circle, 
            #733d4759 0%,
            #733d4726 34%,
            #733d4700 72%,
        );
    }

    //glare on the right side
    Rectangle {
        x: parent.width - 420px;
        y: -240px;
        width: 650px;
        height: 650px;
        border-radius: 325px;

        background: @radial-gradient(circle, 
            #a6414138 0%,
            #a641411c 38%,
            #a6414100 72%
        );
    }

    //central cyan lighting
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 680px;
        height: 680px;
        border-radius: 340px;

        background: @radial-gradient(circle, 
            #71d9d926 0%,
            #71d9d912 34%,
            #71d9d900 70%
        );
    }


    //vigbette to darken the edges
    Rectangle {
        width: 100%;
        height: 100%;

        background: @radial-gradient(circle, 
            #03080d00 32%,
            #03080d66 72%,
            #03080dcc 100%
        );
    }

    Text {
        x: 24px;
        y: parent.height - 70px;
        width: parent.width - 48px;
        text: root.assistant-status;
        color: #71d9d9;
        horizontal-alignment: center;
    }

    VoiceOrb {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 20px;
        ready: root.assistant-ready;
        active: root.assistant-listening;
        speaking: root.assistant-speaking;
        start_program => {
            root.start_program();
        }
    }

    // The panel remains instantiated while collapsed so its externally-bound content
    // is preserved and immediately available when it is opened again.
    session-panel := Rectangle {
        x: parent.width - self.width;
        y: 0px;
        width: root.panel-open ? min(parent.width * 0.82, 400px) : 0px;
        height: parent.height;
        clip: true;
        background: #0a151de8;
        border-color: #71d9d94d;
        border-width: root.panel-open ? 1px : 0px;

        Rectangle {
            width: parent.width;
            height: 4px;
            background: @linear-gradient(90deg, #71d9d900, #71d9d9, #a64141);
        }

        Text {
            x: 20px;
            y: 22px;
            width: parent.width - 72px;
            text: root.panel-title;
            color: #e2ffff;
            font-size: 20px;
            font-weight: 600;
            overflow: elide;
        }

        ScrollView {
            x: 20px;
            y: 66px;
            width: parent.width - 40px;
            height: parent.height - 86px;

            Text {
                width: parent.width;
                text: root.panel-content;
                color: #c4d6d9;
                font-size: 15px;
                wrap: word-wrap;
            }
        }
    }

    // This remains visible in both states, giving narrow layouts a reliable way
    // to reveal or dismiss the session panel.
    Rectangle {
        x: root.panel-open ? session-panel.x - 52px : parent.width - 60px;
        y: 20px;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: #10242ce8;
        border-color: #71d9d973;
        border-width: 1px;
        drop-shadow-color: #03080da6;
        drop-shadow-blur: 10px;

        Text {
            width: parent.width;
            height: parent.height;
            text: root.panel-open ? "×" : "☰";
            color: #71d9d9;
            font-size: 22px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.toggle-panel(); }
        }
    }
}
